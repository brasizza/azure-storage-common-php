{
    "name": "brasizza/azure-storage-common",
    "description": "Community-maintained fork of microsoft/azure-storage-common (retired by Microsoft in March 2024). Not affiliated with Microsoft.",
    "keywords": [
        "php",
        "azure",
        "storage",
        "sdk",
        "common"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marcus Brasizza",
            "role": "Fork maintainer"
        },
        {
            "name": "Azure Storage PHP Client Library",
            "email": "dmsh@microsoft.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "replace": {
        "microsoft/azure-storage-common": "self.version"
    },
    "autoload": {
        "psr-4": {
            "MicrosoftAzure\\Storage\\Common\\": "src/Common"
        }
    }
}
